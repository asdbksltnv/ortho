# Copy to .env for local development. Never commit real values.

# development | production  (production disables OpenAPI docs and requires a real SECRET_KEY)
ENV=development
# true on Render pilot: synthetic data only, persistent warning banner in the UI
DEMO_MODE=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Render supplies postgres://...; it is converted to postgresql+psycopg:// automatically
DATABASE_URL=postgresql+psycopg://orthoready:orthoready@localhost:5432/orthoready
TZ_DISPLAY=Asia/Tashkent
SESSION_TIMEOUT_MIN=15
# Decimal separator used in generated EMR numbers
DECIMAL_SEPARATOR=,

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
# webhook | polling
TELEGRAM_MODE=polling

# AI progress notes: template (default, deterministic) | anthropic
AI_PROVIDER=template
ANTHROPIC_API_KEY=
AI_MODEL=

# disabled | local | s3   (always disabled when DEMO_MODE=true)
STORAGE_BACKEND=disabled

# Directory with the built frontend (set automatically in the Docker image)
FRONTEND_DIST=frontend/dist
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory with clinical/EMR YAML configuration
CONFIG_DIR=config
# Defaults to true when ENV=production; set false only for plain-http local testing
COOKIE_SECURE=
# Login rate limiting: failures allowed per (ip, login) within the window
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MIN=15

# Public https URL of this deployment (registers the Telegram webhook when TELEGRAM_MODE=webhook)
PUBLIC_URL=
# Run the scheduled jobs inside the app process (development only; production uses cron jobs)
SCHEDULER_ENABLED=false
# Local times (TZ_DISPLAY) of the daily digest and the post-op entry reminder
DIGEST_TIME=18:00
POSTOP_REMINDER_TIME=12:00
# Timeout for the optional LLM note generator, seconds
AI_TIMEOUT_S=20
# Wound photos: STORAGE_BACKEND=local uses STORAGE_DIR; s3 needs `pip install -r requirements-s3.txt`
STORAGE_DIR=uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=

# --- AI progress notes ---
# AI_PROVIDER: template (default, deterministic) | openai | anthropic
# OpenAI: set AI_PROVIDER=openai, OPENAI_API_KEY and AI_MODEL (a model name from your account).
OPENAI_API_KEY=
# Only change for an OpenAI-compatible endpoint (Azure/proxy). Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Demo mode only ---
# Optional: give every demo user this password (>= 10 chars) instead of random ones in the deploy log.
# Demo data is synthetic, but anyone who learns this password can log in to the demo.
DEMO_PASSWORD=

# --- First administrator (production; used only while no real admin exists) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Администратор
